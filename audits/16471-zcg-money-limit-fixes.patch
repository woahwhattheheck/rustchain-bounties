 def docstring_rtc_this_week(author):
     """RTC this author has already been granted for docstrings in 7 days.
 
-    Summed from this gate's own `rtc-payout-amount` markers rather than from
-    the chain, so the check works from Actions with no node access and no
-    admin key. Only claims the gate itself verified are counted.
+    The grant event is the gate's trusted `rtc-payout-amount` comment, not the
+    issue creation time. A claim may wait more than seven days for its PR to
+    merge and then be granted today; filtering on `created:` silently erased
+    that grant from the rolling ceiling.
+
+    Search recently UPDATED verified claims (a new gate comment updates the
+    issue), page search results completely, then count only amount-marker
+    comments posted by GitHub Actions inside the precise seven-day window.
+    This keeps the accounting event-aligned and prevents an arbitrary public
+    commenter from manufacturing a cap charge.
     """
-    since = (datetime.datetime.now(datetime.timezone.utc)
-             - datetime.timedelta(days=7)).strftime("%Y-%m-%d")
+    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=7)
+    since = cutoff.strftime("%Y-%m-%d")
     q = (f"repo:{REPO} is:issue author:{author} label:docstring-verified "
-         f"created:>{since}")
-    res = gh(["api", "-X", "GET", "search/issues", "-f", f"q={q}", "-f", "per_page=100"], {}, strict=True)
+         f"updated:>{since}")
+    pages = gh(["api", "--paginate", "--slurp", "-X", "GET", "search/issues",
+                "-f", f"q={q}", "-f", "per_page=100"], [], strict=True)
+    if isinstance(pages, dict):
+        pages = [pages]
+    if not isinstance(pages, list) or any(not isinstance(page, dict) for page in pages):
+        raise GhError("weekly earnings search returned an unexpected pagination shape")
     total = 0.0
-    for it in (res.get("items") or []):
+    items = [it for page in pages for it in (page.get("items") or [])]
+    for it in items:
         if str(it.get("number")) == str(NUM):
             continue          # never count the claim being adjudicated
-        body = it.get("body") or ""
-        # The marker lives in a gate comment, not the issue body, so fetch them.
-        cs = gh(["api", f"/repos/{REPO}/issues/{it['number']}/comments?per_page=100"], [], strict=True) or []
-        for c in cs:
+        comment_pages = gh(["api", "--paginate", "--slurp",
+                            f"/repos/{REPO}/issues/{it['number']}/comments?per_page=100"],
+                           [], strict=True)
+        if comment_pages and all(isinstance(page, list) for page in comment_pages):
+            comments = [c for page in comment_pages for c in page]
+        elif isinstance(comment_pages, list) and all(isinstance(c, dict) for c in comment_pages):
+            comments = comment_pages
+        else:
+            raise GhError("weekly earnings comments returned an unexpected pagination shape")
+        for c in comments:
+            user = c.get("user") or {}
+            if user.get("login") not in {"github-actions[bot]", "github-actions"}:
+                continue
+            created = c.get("created_at") or ""
+            try:
+                created_at = datetime.datetime.fromisoformat(created.replace("Z", "+00:00"))
+            except (TypeError, ValueError) as exc:
+                raise GhError(f"weekly earnings marker has invalid created_at: {created!r}") from exc
+            if created_at < cutoff:
+                continue
             m = re.search(r'<!--\s*rtc-payout-amount:\s*([\d.]+)\s*-->', c.get("body") or "")
             if m:
                 total += float(m.group(1))
                 break
     return round(total, 2)
