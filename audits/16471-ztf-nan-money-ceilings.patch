diff --git a/scripts/bounty_payout.py b/scripts/bounty_payout.py
--- a/scripts/bounty_payout.py
+++ b/scripts/bounty_payout.py
@@
-import os, re, json, time, subprocess, ssl, urllib.request, urllib.error, importlib.util
+import os, re, json, time, subprocess, ssl, urllib.request, urllib.error, importlib.util, math
+from decimal import Decimal, InvalidOperation
+
+def _positive_finite_money(raw, field):
+    """Parse a money config without allowing NaN/Infinity/zero/negative values."""
+    try:
+        value = Decimal(raw)
+    except (InvalidOperation, ValueError, TypeError) as exc:
+        raise SystemExit(f"invalid {field}: expected a finite positive amount") from exc
+    if not value.is_finite() or value <= 0:
+        raise SystemExit(f"invalid {field}: expected a finite positive amount")
+    result = float(value)
+    if not math.isfinite(result) or result <= 0:
+        raise SystemExit(f"invalid {field}: outside finite float range")
+    return result
@@
-RATE=float(os.environ.get("RATE_RTC","3"))
+RATE=_positive_finite_money(os.environ.get("RATE_RTC","3"), "RATE_RTC")
 # Hard ceiling re-enforced at payout time, independent of any gate.
-MAX_CLAIM_RTC=float(os.environ.get("MAX_CLAIM_RTC","25")); MAXRUN=int(os.environ.get("MAX_PER_RUN","40"))
+MAX_CLAIM_RTC=_positive_finite_money(os.environ.get("MAX_CLAIM_RTC","25"), "MAX_CLAIM_RTC"); MAXRUN=int(os.environ.get("MAX_PER_RUN","40"))

