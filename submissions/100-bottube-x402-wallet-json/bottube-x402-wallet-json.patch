From 1e684920bf36f8fdfdded84f2ebf10028ca15269 Mon Sep 17 00:00:00 2001
From: woahwhattheheck <brycembusiness2@gmail.com>
Date: Tue, 15 Sep 2026 12:47:36 -0400
Subject: [PATCH 2/2] test(x402): cover malformed wallet JSON

---
 ...test_bottube_x402_init_app_registration.py | 21 ++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tests/test_bottube_x402_init_app_registration.py b/tests/test_bottube_x402_init_app_registration.py
index 5c530c03..b43ce7f3 100644
--- a/tests/test_bottube_x402_init_app_registration.py
+++ b/tests/test_bottube_x402_init_app_registration.py
@@ -115,3 +115,24 @@ def test_bottube_x402_coinbase_wallet_requires_api_key(tmp_path):
     body = resp.get_json()
     assert body is not None
     assert "error" in body
+
+
+def test_bottube_x402_coinbase_wallet_rejects_malformed_json(tmp_path):
+    app = _fresh_app(tmp_path)
+    client = app.test_client()
+    headers = {"Authorization": "Bearer secret"}
+
+    cases = [
+        ("not-object", "JSON object required"),
+        (["not", "object"], "JSON object required"),
+        ({"coinbase_address": ["0x123"]}, "coinbase_address must be a string"),
+    ]
+
+    for payload, expected_error in cases:
+        resp = client.post(
+            "/api/agents/me/coinbase-wallet",
+            json=payload,
+            headers=headers,
+        )
+        assert resp.status_code == 400
+        assert resp.get_json() == {"error": expected_error}
